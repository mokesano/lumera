<schema version="0.2">

	<!--
	  *
	  * TABLE Invoices
	  *
	  -->
    <table name="invoices">
        <field name="invoice_id" type="I8">
          <KEY/>
          <AUTOINCREMENT/>
        </field>
        <field name="journal_id" type="I8">
          <NOTNULL/>
        </field>
        <field name="user_id" type="I8">
          <NOTNULL/>
        </field>
        <field name="submission_id" type="I8" />
        <field name="invoice_number" type="C2" size="50" />
        <field name="invoice_code" type="C2" size="50" />
        <field name="fee_type" type="C2" size="50">
          <NOTNULL/>
        </field>
        <field name="amount" type="F">
          <NOTNULL/>
        </field>
        <field name="currency_code" type="C2" size="3">
          <NOTNULL/>
        </field>
        <field name="status" type="C2" size="20">
          <NOTNULL/>
          <DEFAULT VALUE="UNPAID"/>
        </field>
        <field name="payment_method" type="C2" size="50" />
        <field name="transfer_bank" type="C2" size="100" />
        <field name="payment_reference" type="C2" size="100" />
        <field name="transfer_confirmed_by" type="I8" />
        <field name="transfer_rejected_reason" type="X" />
        <field name="date_billed" type="T">
          <NOTNULL/>
        </field>
        <field name="date_paid" type="T" />
        <field name="legacy_source_table" type="C2" size="32" />
        <field name="legacy_source_id" type="I8" />
        
        <index name="invoices_journal_id">
            <col>journal_id</col>
        </index>
        <index name="invoices_user_id">
            <col>user_id</col>
        </index>
        <index name="invoices_submission_id">
            <col>submission_id</col>
        </index>
        <index name="uniq_invoices_legacy_source">
            <col>legacy_source_table</col>
            <col>legacy_source_id</col>
            <UNIQUE/>
        </index>
        <index name="uniq_invoices_payment_reference">
            <col>payment_reference</col>
            <UNIQUE/>
        </index>
    </table>

    <!--
      *
      * TABLE Checkout Sessions
      *
      -->
    <table name="checkout_sessions">
        <field name="session_id" type="I8">
            <KEY/>
            <AUTOINCREMENT/>
        </field>
        <field name="journal_id" type="I8">
            <NOTNULL/>
        </field>
        <field name="user_id" type="I8">
            <NOTNULL/>
        </field>
        <field name="assoc_id" type="I8" />
        <field name="type" type="C2" size="64">
            <NOTNULL/>
        </field>
        <field name="amount" type="F">
            <NOTNULL/>
            <DEFAULT VALUE="0"/>
        </field>
        <field name="currency_code" type="C2" size="10">
            <NOTNULL/>
        </field>
        <field name="payload" type="X" />
        <field name="date_created" type="T">
            <NOTNULL/>
        </field>
        <field name="date_modified" type="T">
            <NOTNULL/>
        </field>
        <descr>Sesi checkout 3-tahap (Cart -&gt; Billing -&gt; Payment), terpisah total dari queued_payments legacy.</descr>
        <index name="checkout_sessions_user_id">
            <col>user_id</col>
        </index>
        <index name="checkout_sessions_journal_id">
            <col>journal_id</col>
        </index>
    </table>

    <!--
      *
      * TABLE article_funders
      *
      -->
    <table name="article_funders">
        <field name="funder_id" type="I8">
            <KEY/>
            <AUTOINCREMENT/>
        </field>
        <field name="article_id" type="I8">
            <NOTNULL/>
        </field>
        <field name="seq" type="F">
            <NOTNULL/>
            <DEFAULT VALUE="0"/>
        </field>
        <field name="funder_name" type="C2" size="255">
            <NOTNULL/>
        </field>
        <field name="award_number" type="C2" size="255" />
        <descr>Funder/grant metadata for articles (FundRef data for Crossref deposit).</descr>
        <index name="article_funders_article_id">
            <col>article_id</col>
        </index>
    </table>

    <!--
      *
      * TABLE article_type_custom
      *
      * [WIZDAM] Tipe artikel KUSTOM per-jurnal - mendampingi tipe BAKU
      * (kode JATS standar, didefinisikan sebagai constant di
      * classes/article/ArticleType.inc.php, TIDAK perlu tabel karena
      * tetap sama untuk semua jurnal). Dikelola Journal Manager lewat
      * halaman pengaturan khusus, mirip pengelolaan Section - TAPI
      * SENGAJA TIDAK menggantikan/memodifikasi Section (Section tetap
      * untuk topik/Mini Jurnal, konsep terpisah).
      *
      -->
    <table name="article_type_custom">
        <field name="custom_type_id" type="I8">
            <KEY/>
            <AUTOINCREMENT/>
        </field>
        <field name="journal_id" type="I8">
            <NOTNULL/>
        </field>
        <field name="seq" type="F">
            <NOTNULL/>
            <DEFAULT VALUE="0"/>
        </field>
        <descr>Custom (journal-specific) article types, supplementing the standard JATS-based types.</descr>
        <index name="article_type_custom_journal_id">
            <col>journal_id</col>
        </index>
    </table>

    <!--
      *
      * TABLE article_type_custom_settings
      *
      * [WIZDAM] Nama tipe kustom, di-localize - pola generic settings
      * yang sama seperti article_author_settings (perhatikan: field
      * composite-key di sini SENGAJA HANYA pakai NOTNULL, TANPA KEY -
      * mengikuti PERSIS konvensi tabel settings asli OJS, DTD xmlSchema
      * TIDAK MENGIZINKAN <KEY/> dan <NOTNULL/> pada field yang sama,
      * dan tabel settings serupa di OJS memang tidak mendeklarasikan
      * composite key eksplisit lewat <KEY/> sama sekali).
      *
      -->
    <table name="article_type_custom_settings">
        <field name="custom_type_id" type="I8">
            <NOTNULL/>
        </field>
        <field name="locale" type="C2" size="5">
            <NOTNULL/>
            <DEFAULT VALUE=""/>
        </field>
        <field name="setting_name" type="C2" size="255">
            <NOTNULL/>
        </field>
        <field name="setting_value" type="X" />
        <field name="setting_type" type="C2" size="6">
            <NOTNULL/>
            <DEFAULT VALUE="string"/>
        </field>
        <descr>Localized name for custom article types.</descr>
        <index name="article_type_custom_settings_custom_type_id">
            <col>custom_type_id</col>
        </index>
    </table>
    
</schema>