<data>
    <sql>
        <query driver="mysql">
            ALTER TABLE article_search_objects
              ADD INDEX article_search_objects_article_id (article_id, type)
        </query>
        <query driver="mysql">
            ALTER TABLE metrics
              ADD INDEX metrics_context_id (context_id)
        </query>
        <query driver="mysql">
            ALTER TABLE metrics
              ADD INDEX metrics_assoc_lookup (assoc_type, assoc_id, context_id)
        </query>
    </sql>
</data>