====1,1777184604,SELECT+o.article_id%2C+COUNT%28o.article_id%29+AS+count%0A++++++++++++++++++++++FROM+published_articles+pa%0A++++++++++++++++++++++JOIN+articles+a+ON+pa.article_id+%3D+a.article_id%0A++++++++++++++++++++++JOIN+issues+i+ON+pa.issue_id+%3D+i.issue_id%0A++++++++++++++++++++++JOIN+journals+j+ON+a.journal_id+%3D+j.journal_id%0A+++++++++++++++++++++++JOIN+article_search_objects+o+ON+pa.article_id+%3D+o.article_id+%0A+++++++++++++++++++++++++JOIN+article_search_object_keywords+ok+ON+o.object_id+%3D+ok.object_id+%0A+++++++++++++++++++++++++JOIN+article_search_keyword_list+k+ON+ok.keyword_id+%3D+k.keyword_id+%0A++++++++++++++++++++++WHERE+a.status+%3D+3+%0A++++++++++++++++++++++++AND+i.published+%3D+1+%0A+++++++++++++++++++++++++AND+MATCH%28k.keyword_text%29+AGAINST+%28%3F+IN+BOOLEAN+MODE%29+AND+j.enabled+%3D+1%0A++++++++++++++++++++++GROUP+BY+o.article_id%0A++++++++++++++++++++++ORDER+BY+count+DESC%0A++++++++++++++++++++++LIMIT+500
O:18:"ADORecordSet_array":38:{s:12:"dataProvider";s:6:"native";s:6:"fields";a:4:{i:0;s:3:"741";s:10:"article_id";s:3:"741";i:1;s:1:"4";s:5:"count";s:1:"4";}s:8:"blobSize";i:100;s:7:"canSeek";b:1;s:3:"sql";s:884:"SELECT o.article_id, COUNT(o.article_id) AS count
                      FROM published_articles pa
                      JOIN articles a ON pa.article_id = a.article_id
                      JOIN issues i ON pa.issue_id = i.issue_id
                      JOIN journals j ON a.journal_id = j.journal_id
                       JOIN article_search_objects o ON pa.article_id = o.article_id 
                         JOIN article_search_object_keywords ok ON o.object_id = ok.object_id 
                         JOIN article_search_keyword_list k ON ok.keyword_id = k.keyword_id 
                      WHERE a.status = 3 
                        AND i.published = 1 
                         AND MATCH(k.keyword_text) AGAINST ('+south' IN BOOLEAN MODE) AND j.enabled = 1
                      GROUP BY o.article_id
                      ORDER BY count DESC
                      LIMIT 500";s:3:"EOF";b:0;s:14:"emptyTimeStamp";s:6:"&nbsp;";s:9:"emptyDate";s:6:"&nbsp;";s:5:"debug";b:0;s:11:"timeCreated";i:0;s:4:"bind";b:0;s:9:"fetchMode";i:0;s:10:"connection";b:0;s:10:"_numOfRows";i:53;s:12:"_numOfFields";i:2;s:8:"_queryID";i:1;s:11:"_currentRow";i:0;s:7:"_closed";b:0;s:7:"_inited";b:1;s:4:"_obj";N;s:6:"_names";N;s:12:"_currentPage";i:-1;s:12:"_atFirstPage";b:0;s:11:"_atLastPage";b:0;s:11:"_lastPageNo";i:-1;s:15:"_maxRecordCount";i:0;s:8:"datetime";b:0;s:12:"databaseType";s:5:"array";s:6:"_array";a:53:{i:0;a:4:{i:0;s:3:"741";s:10:"article_id";s:3:"741";i:1;s:1:"4";s:5:"count";s:1:"4";}i:1;a:4:{i:0;s:3:"576";s:10:"article_id";s:3:"576";i:1;s:1:"4";s:5:"count";s:1:"4";}i:2;a:4:{i:0;s:3:"773";s:10:"article_id";s:3:"773";i:1;s:1:"4";s:5:"count";s:1:"4";}i:3;a:4:{i:0;s:3:"634";s:10:"article_id";s:3:"634";i:1;s:1:"4";s:5:"count";s:1:"4";}i:4;a:4:{i:0;s:3:"577";s:10:"article_id";s:3:"577";i:1;s:1:"3";s:5:"count";s:1:"3";}i:5;a:4:{i:0;s:3:"672";s:10:"article_id";s:3:"672";i:1;s:1:"3";s:5:"count";s:1:"3";}i:6;a:4:{i:0;s:3:"620";s:10:"article_id";s:3:"620";i:1;s:1:"2";s:5:"count";s:1:"2";}i:7;a:4:{i:0;s:3:"631";s:10:"article_id";s:3:"631";i:1;s:1:"2";s:5:"count";s:1:"2";}i:8;a:4:{i:0;s:3:"398";s:10:"article_id";s:3:"398";i:1;s:1:"2";s:5:"count";s:1:"2";}i:9;a:4:{i:0;s:3:"573";s:10:"article_id";s:3:"573";i:1;s:1:"2";s:5:"count";s:1:"2";}i:10;a:4:{i:0;s:3:"604";s:10:"article_id";s:3:"604";i:1;s:1:"2";s:5:"count";s:1:"2";}i:11;a:4:{i:0;s:3:"701";s:10:"article_id";s:3:"701";i:1;s:1:"2";s:5:"count";s:1:"2";}i:12;a:4:{i:0;s:3:"416";s:10:"article_id";s:3:"416";i:1;s:1:"2";s:5:"count";s:1:"2";}i:13;a:4:{i:0;s:3:"472";s:10:"article_id";s:3:"472";i:1;s:1:"2";s:5:"count";s:1:"2";}i:14;a:4:{i:0;s:3:"636";s:10:"article_id";s:3:"636";i:1;s:1:"1";s:5:"count";s:1:"1";}i:15;a:4:{i:0;s:3:"600";s:10:"article_id";s:3:"600";i:1;s:1:"1";s:5:"count";s:1:"1";}i:16;a:4:{i:0;s:3:"514";s:10:"article_id";s:3:"514";i:1;s:1:"1";s:5:"count";s:1:"1";}i:17;a:4:{i: