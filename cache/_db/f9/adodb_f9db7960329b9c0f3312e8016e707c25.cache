====1,1776516061,SELECT+o.article_id%2C+COUNT%28o.article_id%29+AS+count%0A++++++++++++++++++++++FROM+published_articles+pa%0A++++++++++++++++++++++JOIN+articles+a+ON+pa.article_id+%3D+a.article_id%0A++++++++++++++++++++++JOIN+issues+i+ON+pa.issue_id+%3D+i.issue_id%0A++++++++++++++++++++++JOIN+journals+j+ON+a.journal_id+%3D+j.journal_id%0A+++++++++++++++++++++++JOIN+article_search_objects+o+ON+pa.article_id+%3D+o.article_id+%0A+++++++++++++++++++++++++JOIN+article_search_object_keywords+ok+ON+o.object_id+%3D+ok.object_id+%0A+++++++++++++++++++++++++JOIN+article_search_keyword_list+k+ON+ok.keyword_id+%3D+k.keyword_id+%0A++++++++++++++++++++++WHERE+a.status+%3D+3+%0A++++++++++++++++++++++++AND+i.published+%3D+1+%0A+++++++++++++++++++++++++AND+MATCH%28k.keyword_text%29+AGAINST+%28%3F+IN+BOOLEAN+MODE%29+AND+j.enabled+%3D+1%0A++++++++++++++++++++++GROUP+BY+o.article_id%0A++++++++++++++++++++++ORDER+BY+count+DESC%0A++++++++++++++++++++++LIMIT+500
O:18:"ADORecordSet_array":38:{s:12:"dataProvider";s:6:"native";s:6:"fields";a:4:{i:0;s:3:"569";s:10:"article_id";s:3:"569";i:1;s:1:"9";s:5:"count";s:1:"9";}s:8:"blobSize";i:100;s:7:"canSeek";b:1;s:3:"sql";s:884:"SELECT o.article_id, COUNT(o.article_id) AS count
                      FROM published_articles pa
                      JOIN articles a ON pa.article_id = a.article_id
                      JOIN issues i ON pa.issue_id = i.issue_id
                      JOIN journals j ON a.journal_id = j.journal_id
                       JOIN article_search_objects o ON pa.article_id = o.article_id 
                         JOIN article_search_object_keywords ok ON o.object_id = ok.object_id 
                         JOIN article_search_keyword_list k ON ok.keyword_id = k.keyword_id 
                      WHERE a.status = 3 
                        AND i.published = 1 
                         AND MATCH(k.keyword_text) AGAINST ('+studi' IN BOOLEAN MODE) AND j.enabled = 1
                      GROUP BY o.article_id
                      ORDER BY count DESC
                      LIMIT 500";s:3:"EOF";b:0;s:14:"emptyTimeStamp";s:6:"&nbsp;";s:9:"emptyDate";s:6:"&nbsp;";s:5:"debug";b:0;s:11:"timeCreated";i:0;s:4:"bind";b:0;s:9:"fetchMode";i:0;s:10:"connection";b:0;s:10:"_numOfRows";i:203;s:12:"_numOfFields";i:2;s:8:"_queryID";i:1;s:11:"_currentRow";i:0;s:7:"_closed";b:0;s:7:"_inited";b:1;s:4:"_obj";N;s:6:"_names";N;s:12:"_currentPage";i:-1;s:12:"_atFirstPage";b:0;s:11:"_atLastPage";b:0;s:11:"_lastPageNo";i:-1;s:15:"_maxRecordCount";i:0;s:8:"datetime";b:0;s:12:"databaseType";s:5:"array";s:6:"_array";a:203:{i:0;a:4:{i:0;s:3:"569";s:10:"article_id";s:3:"569";i:1;s:1:"9";s:5:"count";s:1:"9";}i:1;a:4:{i:0;s:3:"424";s:10:"article_id";s:3:"424";i:1;s:1:"6";s:5:"count";s:1:"6";}i:2;a:4:{i:0;s:3:"432";s:10:"article_id";s:3:"432";i:1;s:1:"4";s:5:"count";s:1:"4";}i:3;a:4:{i:0;s:3:"681";s:10:"article_id";s:3:"681";i:1;s:1:"4";s:5:"count";s:1:"4";}i:4;a:4:{i:0;s:3:"434";s:10:"article_id";s:3:"434";i:1;s:1:"4";s:5:"count";s:1:"4";}i:5;a:4:{i:0;s:2:"44";s:10:"article_id";s:2:"44";i:1;s:1:"4";s:5:"count";s:1:"4";}i:6;a:4:{i:0;s:3:"387";s:10:"article_id";s:3:"387";i:1;s:1:"4";s:5:"count";s:1:"4";}i:7;a:4:{i:0;s:3:"238";s:10:"article_id";s:3:"238";i:1;s:1:"3";s:5:"count";s:1:"3";}i:8;a:4:{i:0;s:3:"542";s:10:"article_id";s:3:"542";i:1;s:1:"3";s:5:"count";s:1:"3";}i:9;a:4:{i:0;s:3:"328";s:10:"article_id";s:3:"328";i:1;s:1:"3";s:5:"count";s:1:"3";}i:10;a:4:{i:0;s:3:"245";s:10:"article_id";s:3:"245";i:1;s:1:"3";s:5:"count";s:1:"3";}i:11;a:4:{i:0;s:3:"529";s:10:"article_id";s:3:"529";i:1;s:1:"3";s:5:"count";s:1:"3";}i:12;a:4:{i:0;s:2:"43";s:10:"article_id";s:2:"43";i:1;s:1:"3";s:5:"count";s:1:"3";}i:13;a:4:{i:0;s:3:"672";s:10:"article_id";s:3:"672";i:1;s:1:"3";s:5:"count";s:1:"3";}i:14;a:4:{i:0;s:3:"186";s:10:"article_id";s:3:"186";i:1;s:1:"2";s:5:"count";s:1:"2";}i:15;a:4:{i:0;s:3:"675";s:10:"article_id";s:3:"675";i:1;s:1:"2";s:5:"count";s:1:"2";}i:16;a:4:{i:0;s:3:"386";s:10:"article_id";s:3:"386";i:1;s:1:"2";s:5:"count";s:1:"2";}i:17;a:4:{i:0;