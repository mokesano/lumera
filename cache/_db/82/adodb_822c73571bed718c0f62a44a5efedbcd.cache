====1,1777310202,SELECT+o.article_id%2C+COUNT%28o.article_id%29+AS+count%0A++++++++++++++++++++++FROM+published_articles+pa%0A++++++++++++++++++++++JOIN+articles+a+ON+pa.article_id+%3D+a.article_id%0A++++++++++++++++++++++JOIN+issues+i+ON+pa.issue_id+%3D+i.issue_id%0A++++++++++++++++++++++JOIN+journals+j+ON+a.journal_id+%3D+j.journal_id%0A+++++++++++++++++++++++JOIN+article_search_objects+o+ON+pa.article_id+%3D+o.article_id+%0A+++++++++++++++++++++++++JOIN+article_search_object_keywords+ok+ON+o.object_id+%3D+ok.object_id+%0A+++++++++++++++++++++++++JOIN+article_search_keyword_list+k+ON+ok.keyword_id+%3D+k.keyword_id+%0A++++++++++++++++++++++WHERE+a.status+%3D+3+%0A++++++++++++++++++++++++AND+i.published+%3D+1+%0A+++++++++++++++++++++++++AND+MATCH%28k.keyword_text%29+AGAINST+%28%3F+IN+BOOLEAN+MODE%29+AND+j.enabled+%3D+1%0A++++++++++++++++++++++GROUP+BY+o.article_id%0A++++++++++++++++++++++ORDER+BY+count+DESC%0A++++++++++++++++++++++LIMIT+500
O:18:"ADORecordSet_array":38:{s:12:"dataProvider";s:6:"native";s:6:"fields";b:0;s:8:"blobSize";i:100;s:7:"canSeek";b:1;s:3:"sql";s:1791:"SELECT o.article_id, COUNT(o.article_id) AS count
                      FROM published_articles pa
                      JOIN articles a ON pa.article_id = a.article_id
                      JOIN issues i ON pa.issue_id = i.issue_id
                      JOIN journals j ON a.journal_id = j.journal_id
                       JOIN article_search_objects o ON pa.article_id = o.article_id 
                         JOIN article_search_object_keywords ok ON o.object_id = ok.object_id 
                         JOIN article_search_keyword_list k ON ok.keyword_id = k.keyword_id 
                      WHERE a.status = 3 
                        AND i.published = 1 
                         AND MATCH(k.keyword_text) AGAINST ('+20b +20and +20c +20were +20partners +20their +20capitals +20were +20rs +20rs +20and +20rs +20respectively +20according +20to +0athe +20partnership +20deed +20they +20were +20entitled +20to +20interest +20on +20capital +20per +20annum +20in +20addition +20b +20was +20also +20entitled +20to +0adraw +20a +20salary +20of +20rs +20per +20month +20c +20was +20entitled +20to +20a +20commission +20of +20on +20the +20profits +20after +20charging +20the +20interest +0aon +20capitals +20but +20before +20charging +20the +20salary +20payable +20to +20b +20the +20net +20profits +20for +20the +20year +20were +20rs +20distributed +20in +0athe +20ratio +20of +20their +20capitals +20without +20providing +20for +20any +20of +20the +20above +20adjustments +20the +20profits +20were +20to +20be +20shared +20in +20the +0aratio +20of +20pass +20the +20necessary +20adjustment +20entry +20showing +20the +20working +20clearly' IN BOOLEAN MODE) AND j.enabled = 1
                      GROUP BY o.article_id
                      ORDER BY count DESC
                      LIMIT 500";s:3:"EOF";b:1;s:14:"emptyTimeStamp";s:6:"&nbsp;";s:9:"emptyDate";s:6:"&nbsp;";s:5:"debug";b:0;s:11:"timeCreated";i:0;s:4:"bind";b:0;s:9:"fetchMode";i:0;s:10:"connection";b:0;s:10:"_numOfRows";i:0;s:12:"_numOfFields";i:2;s:8:"_queryID";i:1;s:11:"_currentRow";i:-1;s:7:"_closed";b:0;s:7:"_inited";b:1;s:4:"_obj";N;s:6:"_names";N;s:12:"_currentPage";i:-1;s:12:"_atFirstPage";b:0;s:11:"_atLastPage";b:0;s:11:"_lastPageNo";i:-1;s:15:"_maxRecordCount";i:0;s:8:"datetime";b:0;s:12:"databaseType";s:5:"array";s:6:"_array";a:0:{}s:6:"_types";N;s:9:"_colnames";N;s:9:"_skiprow1";b:0;s:9:"_fieldarr";N;s:12:"affectedrows";b:0;s:8:"insertid";b:0;s:6:"compat";b:0;s:11:"oldProvider";s:6:"native";s:13:"_fieldobjects";a:2:{i:0;O:8:"stdClass":18:{s:4:"name";s:10:"article_id";s:7:"orgname";s:10:"article_id";s:5:"table";s:1:"o";s:8:"orgtable";s:22:"article_search_objects";s:3:"def";s:0:"";s:2:"db";s:17:"sangiaor_ojs20171";s:7:"catalog";s:3:"def";s:10:"max_length";i:0;s:6:"length";i:20;s:9:"charsetnr";i:63;s:5:"flags";i:36865;s:4:"type";i:8;s:8:"decimals";i:0;s:11:"primary_key";i:0;s:8:"not_null";i:1;s:14:"auto_increment";i:0;s:6:"binary";i:0;s:8:"unsigned";i:0;}i:1;O:8:"stdClass":18:{s:4:"name";s:5:"count";s:7:"orgname";s:0:"";s:5:"table";s:0:"";s:8:"orgtable";s:0:"";s:3:"def";s:0:"";s:2:"db";s:0:"";s:7:"catalog";s:3:"def";s:10:"max_length";i:0;s:6:"length";i:21;s:9:"charsetnr";i:63;s:5:"flags";i:32769;s:4:"type";i:8;s:8:"decimals";i:0;s:11:"primary_key";i:0;s:8:"not_null";i:1;s:14:"auto_increment";i:0;s:6:"binary";i:0;s:8:"unsigned";i:0;}}}