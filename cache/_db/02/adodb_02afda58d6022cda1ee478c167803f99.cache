====1,1777419452,SELECT++++a.article_id+AS+pub_id%2C%0A++++++++++++++++COALESCE%28atl.setting_value%2C+atpl.setting_value%29+AS+article_title%0A++++++++++++FROM++++published_articles+pa%2C%0A++++++++++++++++issues+i%2C%0A++++++++++++++++articles+a%0A++++++++++++++++JOIN+journals+j+ON+%28a.journal_id+%3D+j.journal_id%29%0A++++++++++++++++LEFT+JOIN+sections+s+ON+s.section_id+%3D+a.section_id%0A++++++++++++++++LEFT+JOIN+article_settings+atl+ON+%28a.article_id+%3D+atl.article_id+AND+atl.setting_name+%3D+%3F+AND+atl.locale+%3D+%3F%29%0A++++++++++++++++LEFT+JOIN+article_settings+atpl+ON+%28a.article_id+%3D+atpl.article_id+AND+atpl.setting_name+%3D+%3F+AND+atpl.locale+%3D+a.locale%29%0A++++++++++++WHERE++++pa.article_id+%3D+a.article_id%0A++++++++++++++++AND+a.status+%3C%3E+0%0A++++++++++++++++AND+i.issue_id+%3D+pa.issue_id%0A++++++++++++++++AND+i.published+%3D+1%0A++++++++++++++++AND+s.section_id+IS+NOT+NULL+AND+a.journal_id+%3D+%3F+ORDER+BY+article_title
O:18:"ADORecordSet_array":38:{s:12:"dataProvider";s:6:"native";s:6:"fields";a:4:{i:0;s:2:"35";s:6:"pub_id";s:2:"35";i:1;s:0:"";s:13:"article_title";s:0:"";}s:8:"blobSize";i:100;s:7:"canSeek";b:1;s:3:"sql";s:888:"SELECT    a.article_id AS pub_id,
                COALESCE(atl.setting_value, atpl.setting_value) AS article_title
            FROM    published_articles pa,
                issues i,
                articles a
                JOIN journals j ON (a.journal_id = j.journal_id)
                LEFT JOIN sections s ON s.section_id = a.section_id
                LEFT JOIN article_settings atl ON (a.article_id = atl.article_id AND atl.setting_name = 'cleanTitle' AND atl.locale = 'en_US')
                LEFT JOIN article_settings atpl ON (a.article_id = atpl.article_id AND atpl.setting_name = 'cleanTitle' AND atpl.locale = a.locale)
            WHERE    pa.article_id = a.article_id
                AND a.status <> 0
                AND i.issue_id = pa.issue_id
                AND i.published = 1
                AND s.section_id IS NOT NULL AND a.journal_id = 1 ORDER BY article_title";s:3:"EOF";b:0;s:14:"emptyTimeStamp";s:6:"&nbsp;";s:9:"emptyDate";s:6:"&nbsp;";s:5:"debug";b:0;s:11:"timeCreated";i:0;s:4:"bind";b:0;s:9:"fetchMode";i:0;s:10:"connection";b:0;s:10:"_numOfRows";i:151;s:12:"_numOfFields";i:2;s:8:"_queryID";i:1;s:11:"_currentRow";i:0;s:7:"_closed";b:0;s:7:"_inited";b:1;s:4:"_obj";N;s:6:"_names";N;s:12:"_currentPage";i:-1;s:12:"_atFirstPage";b:0;s:11:"_atLastPage";b:0;s:11:"_lastPageNo";i:-1;s:15:"_maxRecordCount";i:0;s:8:"datetime";b:0;s:12:"databaseType";s:5:"array";s:6:"_array";a:151:{i:0;a:4:{i:0;s:2:"35";s:6:"pub_id";s:2:"35";i:1;s:0:"";s:13:"article_title";s:0:"";}i:1;a:4:{i:0;s:3:"609";s:6:"pub_id";s:3:"609";i:1;s:144:"<i>Punggawa</i> authority and its <i>Sawi</i> compliance during the Covid19 Pandemic <i>Case study on Beba Fishing Community Takalar Regency</i>";s:13:"article_title";s:144:"<i>Punggawa</i> authority and its <i>Sawi</i> compliance during the Covid19 Pandemic <i>Case study on Beba Fishing Community Takalar Regency</i>";}i:2;a:4:{i:0;s:3:"685";s:6:"pub_id";s:3:"685";i:1;s:93:"A study of water depth on the growth and productivity of seaweed <i>Kappaphycus alvarezii</i>";s:13:"article_title";s:93:"A study of water depth on the growth and productivity of seaweed <i>Kappaphycus alvarezii</i>";}i:3;a:4:{i:0;s:3:"648";s:6:"pub_id";s:3:"648";i:1;s:84:"Abundance and temporal distribution of mullets caught in Merauke City Coastal Waters";s:13:"article_title";s:84:"Abundance and temporal distribution of mullets caught in Merauke City Coastal Waters";}i:4;a:4:{i:0;s:3:"759";s:6:"pub_id";s:3:"759";i:1;s:84:"An analysis of fish catch yields using natural liquid bait in the Kampung Beru River";s:13:"article_title";s:84:"An analysis of fish catch yields using natural liquid bait in the Kampung Beru River";}i:5;a:4:{i:0;s:3:"214";s:6:"pub_id";s:3:"214";i:1;s:197:"Analysis and identification of <i>Pseudomonas</i> sp and molds on dried anchovy <i>