        <style>@media(max-width:500px){.Sangia-970x90{width:320px;height:90px;}}@media(min-width: 500px){.Sangia-970x90{width:970px;height:90px;}}@media(min-width:800px){.Sangia-970x90{width:970px;height:90px;}}
